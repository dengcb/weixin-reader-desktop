{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "default",
  "description": "Capability for the main window with remote domain access",
  "windows": ["main", "settings", "privacy", "terms"],
  "remote": {
    "urls": [
      "https://weread.qq.com/*",
      "https://*.weread.qq.com/*",
      "https://fanqienovel.com/*",
      "https://*.fanqienovel.com/*",
      "http://localhost.weixin.qq.com:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "store:default",
    "window-state:default",
    "log:default",
    "shell:allow-open",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-create",
    "updater:default",
    "dialog:default",
    "fs:default",
    "allow-log-frontend",
    "allow-log-to-file",
    "allow-update-menu-state",
    "allow-set-menu-item-enabled",
    "allow-set-active-bookstore",
    "allow-set-zoom",
    "allow-close-window",
    "allow-set-title",
    "allow-apply-site-zoom",
    "allow-get-app-name",
    "allow-get-app-version",
    "allow-get-available-monitors",
    "allow-move-window-to-monitor",
    "allow-get-current-monitor",
    "allow-navigate-to-url",
    "allow-set-cursor-visible",
    "allow-get-weread-book-progress",
    "allow-install-plugin",
    "allow-uninstall-plugin",
    "allow-get-installed-plugins",
    "allow-get-plugin-config",
    "allow-save-plugin-config",
    "allow-get-plugin-code",
    "allow-load-plugin-for-edit",
    "allow-save-plugin",
    "allow-save-plugin-dialog",
    "allow-install-plugin-from-editor",
    "allow-get-settings",
    "allow-save-settings",
    "allow-check-update-manual",
    "allow-install-update-now",
    "allow-is-update-downloaded",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://weread.qq.com/*" },
        { "url": "https://*.weread.qq.com/*" }
      ]
    }
  ]
}
