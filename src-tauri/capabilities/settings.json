{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Trusted local settings and plugin-management window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "dialog:default",
    "opener:default",
    "allow-get-app-name",
    "allow-get-app-version",
    "allow-get-settings",
    "allow-patch-settings",
    "allow-set-content-source-enabled",
    "allow-claim-settings-target",
    "allow-clear-local-history",
    "allow-install-plugin",
    "allow-prepare-plugin-install",
    "allow-uninstall-plugin",
    "allow-get-installed-plugins",
    "allow-load-plugin-for-edit",
    "allow-check-update-manual",
    "allow-install-update-now",
    "allow-is-update-downloaded"
  ]
}
