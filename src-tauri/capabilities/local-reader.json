{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-reader",
  "description": "Trusted local TXT and EPUB reader in the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-log-to-file",
    "allow-update-menu-state",
    "allow-set-menu-item-enabled",
    "allow-set-active-bookstore",
    "allow-set-title",
    "allow-toggle-menu-bar",
    "allow-simulate-menu-click",
    "allow-switch-bookstore-by-index",
    "allow-apply-site-zoom",
    "allow-get-app-name",
    "allow-get-settings",
    "allow-patch-settings",
    "allow-get-local-book",
    "allow-get-local-reading-progress",
    "allow-save-local-reading-progress",
    "allow-local-sha1"
  ]
}
