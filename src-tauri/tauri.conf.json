{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "艾特阅读",
  "version": "1.3.0",
  "identifier": "com.dengcb.reader",
  "build": {
    "beforeDevCommand": "bun run build",
    "devUrl": null,
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dengcb/weixin-reader-desktop/releases/latest/download/latest.json",
        "https://ghproxy.com/https://github.com/dengcb/weixin-reader-desktop/releases/latest/download/latest.json",
        "https://mirror.ghproxy.com/https://github.com/dengcb/weixin-reader-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgODIwMEM2QkM0NkIzQTA3OApSV1NDQU1hOFJyT2dlRHRFS2N6S3RxWk0wcFNoaWpxQ0EyRkE3TWxhVCs5NktZb3ppN0dnV2t2eg=="
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main-runtime",
        "settings",
        "plugin-editor",
        "plugin-installer",
        "legal-documents"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "atrd"
        ],
        "name": "艾特阅读插件",
        "description": "艾特阅读插件安装包",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-atreader-plugin",
        "exportedType": {
          "identifier": "com.dengcb.reader.atrd",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
