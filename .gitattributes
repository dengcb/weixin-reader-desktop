# 编译产物：文件照常入库与提交（CI 校验产物一致性依赖此），
# 但 diff 不展示内容——防止海量压缩产物 diff 淹没审查与 AI 生成的提交信息
src/scripts/inject.js -diff
src/scripts/local_reader.js -diff
src/scripts/local_reader_bootstrap.js -diff

# 自动生成的权限表（Tauri permissions）：内容仍可审（真实变更都是新增命令），
# 统一 LF 检出，根治 Windows 工作区 CRLF「幽灵改动」（git status 伪 dirty）
src-tauri/permissions/autogenerated/** text eol=lf

# 三个生成产物同步声明 LF：与 -diff 声明同文件兼容；它们是每次合并后
# 「重跑 build 再提交」的对象，CRLF 幻影 dirty 会干扰产物一致性判断
src/scripts/inject.js text eol=lf
src/scripts/local_reader.js text eol=lf
src/scripts/local_reader_bootstrap.js text eol=lf
