{
  "id": "qidian",
  "name": "起点中文",
  "version": "1.0.0",
  "description": "起点中文网网站支持插件（官方）",
  "author": "艾特阅读团队",
  "homepage": "https://github.com/dengcb/weixin-reader-desktop",
  "sourceType": "web",
  "renderMode": "webview",
  "site": {
    "domain": [
      "qidian.com"
    ],
    "homeUrl": "https://www.qidian.com/",
    "readerPattern": "/chapter/\\d+/\\d+",
    "shelf": "https://my.qidian.com/bookcase/"
  },
  "capabilities": {
    "wideMode": true,
    "hideToolbar": true,
    "autoFlip": true,
    "chapterNav": true,
    "progressTracker": true,
    "doubleColumn": true,
    "hideNavbar": true,
    "hideCursor": true,
    "remoteControl": true,
    "nativeTheme": true
  },
  "builtin": true,
  "icon": "data:image/png;base64,"
}
