{
  "id": "fanqie",
  "name": "番茄小说",
  "version": "1.0.0",
  "description": "番茄小说网站支持插件（官方范例）",
  "author": "艾特阅读团队",
  "homepage": "https://github.com/dengcb/weixin-reader-desktop",
  "icon": "data:image/png;base64,",
  "sourceType": "web",
  "renderMode": "webview",
  "site": {
    "domain": [
      "fanqienovel.com"
    ],
    "homeUrl": "https://fanqienovel.com/",
    "readerPattern": "/reader/",
    "shelf": "https://fanqienovel.com/bookshelf"
  },
  "capabilities": {
    "wideMode": true,
    "hideToolbar": true,
    "autoFlip": true,
    "chapterNav": true,
    "progressTracker": true,
    "doubleColumn": true,
    "hideNavbar": true,
    "hideCursor": true,
    "remoteControl": true
  },
  "builtin": true
}
