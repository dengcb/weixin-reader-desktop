{
  "id": "weread",
  "name": "微信读书",
  "version": "1.0.2",
  "description": "微信读书网站支持插件",
  "author": "艾特阅读团队",
  "homepage": "https://github.com/dengcb/weixin-reader-desktop",
  "sourceType": "web",
  "renderMode": "webview",
  "site": {
    "domain": [
      "weread.qq.com"
    ],
    "homeUrl": "https://weread.qq.com/",
    "readerPattern": "/web/reader/",
    "shelf": "https://weread.qq.com/web/shelf"
  },
  "capabilities": {
    "wideMode": true,
    "hideToolbar": true,
    "hideNavbar": true,
    "autoFlip": true,
    "chapterNav": true,
    "progressTracker": true,
    "doubleColumn": true,
    "hideCursor": true,
    "remoteControl": true,
    "fixedFirst": true,
    "monochromeIcon": "data:image/svg+xml;base64,"
  },
  "icon": "data:image/png;base64,"
}
